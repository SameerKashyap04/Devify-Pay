{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @devify/database prisma generate && pnpm --filter @devify/api build"
  },
  "deploy": {
    "startCommand": "node_modules/.bin/tsx apps/api/src/server.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
