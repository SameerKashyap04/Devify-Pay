{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @devify/database run prisma:generate && pnpm --filter @devify/api build"
  },
  "deploy": {
    "startCommand": "pnpm db:deploy && pnpm --filter @devify/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
