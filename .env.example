NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://devify:devify@localhost:5432/devify_pay?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Ports / URLs ---
API_PORT=4000
ADMIN_URL=http://localhost:3000
API_URL=http://localhost:4000
CHECKOUT_URL=http://localhost:4000/pay

# --- Manual UPI Provider ---
UPI_MERCHANT_ID=yourmerchant@upi
UPI_MERCHANT_NAME=Devify

# --- Secrets (generate strong random values; never commit real ones) ---
JWT_SECRET=change_me_dev_only
SESSION_SECRET=change_me_dev_only
ENCRYPTION_KEY=change_me_32_byte_hex_key_dev_only
WEBHOOK_SIGNING_SECRET=change_me_dev_only

# --- Logging ---
LOG_LEVEL=info

# --- Rate limits (requests per window, window in ms) ---
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=200
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000

# --- Webhook retry schedule (comma separated seconds) ---
WEBHOOK_RETRY_SCHEDULE_SECONDS=0,30,120,600,1800,7200
